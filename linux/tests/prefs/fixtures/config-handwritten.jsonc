// A hand-edited config.json, as a user might keep it: comments, trailing commas, a Slate syntax
// action, keys spelled out instead of "hyper".
{
  "keyboard": { "capsLock": "hyper", "capsLockAlone": "escape", },
  "bindings": [
    {
      "id": "6F1E3A2C-1D7B-4E7A-9C8B-2A1B3C4D5E6F",
      "name": "Left half",
      "keys": "hyper+a",
      "action": { "op": "move", "x": "screenOriginX", "y": "screenOriginY", "width": "screenSizeX/2", "height": "screenSizeY" },
    },
    {
      "id": "0B0E4F0A-2A9A-4E33-8D7C-6C5B4A392817",
      "keys": "ctrl+alt+shift+cmd+right",
      "action": { "op": "throw", "screen": "right", "width": "screenSizeX", "height": "screenSizeY" },
    },
  ],
  "hotstrings": [
    { "id": "8C9D0E1F-2A3B-4C5D-8E7F-901A2B3C4D5E", "trigger": ";shrug", "replacement": "¯\\_(ツ)_/¯" },
  ],
  "settings": { "nudgePercentOf": "screenSize" },
}
