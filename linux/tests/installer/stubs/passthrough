#!/bin/bash
# Stand-in for sudo, setsid and dbus-run-session, for linux/tests/installer/run.sh: records the call
# in $STUB_LOG and runs the command itself (no privileges, no new session or bus). As sudo:
# `sudo -n true` (are credentials cached?) succeeds only with STUB_SUDO_CACHED=1, and
# STUB_SUDO_FAILS=1 plays a wrong password.
name="$(basename "$0")"
echo "$name $*" >>"$STUB_LOG"
if [ "$name" = sudo ]; then
  [ "${STUB_SUDO_FAILS:-0}" = 1 ] && { echo "sudo: 3 incorrect password attempts" >&2; exit 1; }
  while [ "${1:-}" != "${1#-}" ]; do
    [ "$1" = -n ] && [ "${STUB_SUDO_CACHED:-0}" != 1 ] && exit 1
    shift
  done
fi
[ "${1:-}" = "--" ] && shift
exec "$@"
